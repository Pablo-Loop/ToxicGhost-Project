  m_Script: {fileID: 11500000, guid: be40e18b317e50645b1d0d17ed8c368b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChatManager
  sistemaToxicidad: {fileID: 1873063211}
  celular: {fileID: 302267135}
  textoMensaje: {fileID: 1514678030}
  notificacion: {fileID: 302267140}
  botonAsertiva: {fileID: 1365217431}
  botonSumisa: {fileID: 1449993961}
  botonAgresiva: {fileID: 826480476}
  tiempoParaCerrar: 3
  conversaciones:
  - mensajeLiam: "\xBFD\xF3nde est\xE1s? Te llevo escribiendo..."
    respuestaAsertiva: Estoy comiendo con mis amigas amor
    respuestaSumisa: "Tranquilo,pronto estar\xE9 contigo"
    respuestaAgresiva: 'Estoy cogiendole la rama a Morion '
    liamAsertiva: Bueno amor, eso espero
    liamSumisa: 'Dale amor, espero no digas mentiras '
    liamAgresiva: "Ya ver\xE1s que a los dos los voy a quemar "
  - mensajeLiam: "No est\xE1 gustando esto"
    respuestaAsertiva: 'Amor, calma sabes que te amo '
    respuestaSumisa: Amor, no aguanto mas te quieor bajar esos calvin klein
    respuestaAgresiva: 'Ya le exprimi la rama a Morion '
    liamAsertiva: 'Dale amo...te amo '
    liamSumisa: 'Amor y yo te quiero rasgar esas victoria secret '
    liamAgresiva: 'Ya estoy en el carro van a verselas conmigo '
  - mensajeLiam: 
    respuestaAsertiva: 
    respuestaSumisa: 
    respuestaAgresiva: 
    liamAsertiva: 
    liamSumisa: 
    liamAgresiva: 
  - mensajeLiam: 
    respuestaAsertiva: 
    respuestaSumisa: 
    respuestaAgresiva: 
    liamAsertiva: 
    liamSumisa: 
    liamAgresiva: 
  - mensajeLiam: 
